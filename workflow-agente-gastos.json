    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst mes = $now.toFormat('yyyy-MM');\nlet total = 0, tarjeta = 0, cantidad = 0;\n\nfor (const it of items) {\n  const f = String(it.json['Fecha'] ?? '');\n  let ym = '';\n  if (/^\\d{4}-\\d{2}/.test(f)) ym = f.slice(0, 7);\n  else if (/^\\d{1,2}\\/\\d{1,2}\\/\\d{4}/.test(f)) {\n    const p = f.split('/');\n    ym = p[2] + '-' + p[1].padStart(2, '0');\n  }\n  if (ym !== mes) continue;\n\n  const imp = Number(String(it.json['Importe'] ?? '').replace(/[^\\d.,-]/g, '').replace(',', '.')) || 0;\n  total += imp;\n  cantidad++;\n  if (/cr[eé]dito/i.test(String(it.json['Medio de pago'] ?? ''))) tarjeta += imp;\n}\n\nreturn [{ json: { mes, total_mes: total, total_tarjeta_mes: tarjeta, cantidad_gastos: cantidad } }];"
      },
